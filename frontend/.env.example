# Base URL of the backend API, including the /api prefix.
#
# Copy to frontend/.env. This value is inlined into the browser bundle at build
# time (NEXT_PUBLIC_ prefix), so it must be a URL the browser can reach - not a
# Docker service name. Never put secrets in a NEXT_PUBLIC_ variable.
#
# If this host is unreachable the dashboard also tries http://127.0.0.1:4000/api
# and http://localhost:4000/api, then shows a retry message naming what it tried.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api

# Server-side destination used by the same-origin /backend-api proxy.
# Browser requests use the proxy first, avoiding CORS and localhost/127.0.0.1
# differences. In Docker this can be http://backend:4000.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
