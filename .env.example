# Copy this file to .env before starting Docker Compose.
# Change POSTGRES_PASSWORD and set ADMIN_EMAILS to the email address that
# should receive admin access when it registers through the web interface.
POSTGRES_USER=tender_app
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=tender_platform

WEB_PORT=3000
API_PORT=4000
DB_PORT=5432
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Keep false for local HTTP. Set true only when the site is served via HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_EMAILS=admin@example.com

# Required only when configuring SMTP alerts in the Admin console.
MAIL_SETTINGS_KEY=
PORTAL_SCRAPE_ENABLED=true
