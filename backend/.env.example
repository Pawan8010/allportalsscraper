# ---------------------------------------------------------------------------
# RRP Groups Tender Search - backend configuration
#
# Copy to backend/.env and edit. Every variable below is validated at startup
# (src/config/env.ts); the process refuses to boot with an actionable message
# rather than failing later at runtime.
#
# Never commit the real .env - it holds the database password.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string. Must start with postgresql:// or postgres://
#
# This project uses its OWN database, separate from anything else on the host.
# To create it (run once, as a superuser):
#
#   CREATE ROLE rrp_user LOGIN PASSWORD 'choose-a-password';
#   CREATE DATABASE rrp_tender_db OWNER rrp_user;
#   \c rrp_tender_db
#   CREATE EXTENSION IF NOT EXISTS pg_trgm;
#   CREATE EXTENSION IF NOT EXISTS unaccent;
#
# then apply the schema with:  npm run prisma:deploy
DATABASE_URL="postgresql://rrp_user:choose-a-password@localhost:5432/rrp_tender_db?schema=public"


# --- API server -----------------------------------------------------------

PORT=4000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API.
# An entry for localhost also authorises the matching 127.0.0.1 form, and vice
# versa, because a browser treats them as different origins.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Fail a request with a readable JSON error instead of letting it hang.
REQUEST_TIMEOUT_MS=30000

# Per-IP request budget for /api, per minute. Search runs on every keystroke,
# so this is deliberately generous.
RATE_LIMIT_PER_MINUTE=300


# --- GeM and government portal scrapers ----------------------------------

# Public GeM bid portal. Only public listing pages are read; robots.txt
# disallows /resources/ and some bank-guarantee endpoints, none of which this
# scraper touches.
GEM_BASE_URL=https://bidplus.gem.gov.in

# Page cap for a full sweep. 0 = no cap: follow pagination until GeM reports no
# more results. The total is always read from the portal, never assumed.
SCRAPER_MAX_PAGES=0

# Page a full sweep begins on. Normally 1 - an interrupted run resumes from its
# own recorded watermark regardless of this value.
SCRAPER_START_PAGE=1

# Pages a "scrape new tenders" run walks, newest first.
NEW_TENDER_MAX_PAGES=60

# Politeness controls. Raising concurrency or lowering the delay puts more load
# on a public government portal - keep these conservative.
SCRAPER_REQUEST_DELAY_MS=150
SCRAPER_API_CONCURRENCY=6
PORTAL_SCRAPER_CONCURRENCY=3

# Attempts per page before it is recorded as failed. Retries use exponential
# backoff with jitter.
SCRAPER_MAX_RETRIES=4

# Per-request timeout for scraper HTTP calls (ms).
SCRAPER_TIMEOUT_MS=45000

# User agent sent to GeM. Keep it honest and identifiable.
# SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# The selected GePNIC portals reuse the same timeout, retry and user-agent
# settings. Their adapters read only public "Tenders by Organisation" pages
# and do not submit or bypass CAPTCHA-protected search forms.

# Headless mode for the Playwright-based scraper (src/scraper/gemScraper.ts).
SCRAPER_HEADLESS=true


# --- Scheduler ------------------------------------------------------------

# Automatic incremental scrape, every six hours by default.
# Leave empty to disable scheduled scraping entirely.
SCRAPE_CRON="0 */6 * * *"


# --- Live GeM search sync -------------------------------------------------

# When true, searching a new term schedules a *background* sync against GeM's
# public search so the stored corpus stays current for terms people actually
# use. Search requests are always served from PostgreSQL and never wait on it.
# Set to false to stop all outbound GeM traffic during search.
LIVE_SEARCH_ENABLED=true

# Pages of GeM live search to sync per term.
LIVE_SEARCH_MAX_PAGES=10

# How long a synced snapshot stays fresh before another sync is scheduled (ms).
LIVE_SEARCH_TTL_MS=900000
