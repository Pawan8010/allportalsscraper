# --- Database ---
# Never commit real credentials. Fill this in locally / in your deployment secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tender_platform?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Portal scraping (global) ---
PORTAL_SCRAPE_ENABLED=true
PORTAL_CONCURRENCY=3
PORTAL_REQUEST_DELAY_MS=500
PORTAL_MAX_RETRIES=3
PORTAL_TIMEOUT_MS=45000
# Concurrent organisation-page fetches within one GePNIC portal's crawl.
GEPNIC_ORG_CONCURRENCY=6
# Incremental (latest-page) check, cheap per portal -- hourly.
SCRAPE_CRON="0 * * * *"
# Full re-walk of every page, once a day at 3am local time.
FULL_SCRAPE_CRON="0 3 * * *"
# Scrape once immediately on backend startup instead of waiting for the
# first cron mark.
SCRAPE_ON_STARTUP=true

# --- Per-portal kill switches ---
# Every portal defaults to true except the three flagged "needs deep review"
# in the architecture plan. Flip to false to disable any portal without touching code.
PORTAL_GEM_ENABLED=true
PORTAL_CPPP_ENABLED=true
PORTAL_DEFPROC_ENABLED=true
PORTAL_MAHARASHTRA_ENABLED=true
PORTAL_TAMILNADU_ENABLED=true
PORTAL_UTTARPRADESH_ENABLED=true
PORTAL_RAJASTHAN_ENABLED=true
PORTAL_MADHYAPRADESH_ENABLED=true
PORTAL_HARYANA_ENABLED=true
PORTAL_PUNJAB_ENABLED=true
PORTAL_KERALA_ENABLED=true
PORTAL_WESTBENGAL_ENABLED=true
PORTAL_ODISHA_ENABLED=true
PORTAL_JHARKHAND_ENABLED=true
PORTAL_ASSAM_ENABLED=true
PORTAL_BIHAR_ENABLED=true
# Re-checked 26 Jul 2026 against the fixed GePNIC adapter: works like any
# other state portal (see portalRegistry.ts comment).
PORTAL_COALINDIA_ENABLED=true

# IREPS: guest search genuinely requires a real mobile number + SMS OTP
# (deliberate access control, not a technical gap) -- see
# docs/PORTAL_FEASIBILITY.md. Assisted (human-browsed) scraping only.
PORTAL_IREPS_ENABLED=false

# Gujarat/Karnataka/Telangana/Andhra Pradesh migrated off the shared NIC
# GePNIC platform, but each now has its own real automatic adapter --
# gujaratNprocureAdapter.ts, kpppAdapter.ts, csrfBootstrapAdapter.ts
# (shared by the latter two). See docs/PORTAL_FEASIBILITY.md for how each
# was found and confirmed live (27 Jul 2026).
PORTAL_GUJARAT_NPROCURE_ENABLED=true
PORTAL_KARNATAKA_ENABLED=true
PORTAL_TELANGANA_ENABLED=true
PORTAL_ANDHRAPRADESH_ENABLED=true

# --- Logging ---
LOG_LEVEL=info

# --- Tender lifecycle ---
# Permanently deletes tenders past their own closingDate on a daily cron.
TENDER_CLEANUP_ENABLED=true
TENDER_CLEANUP_CRON="30 3 * * *"
# Days to wait after closing before deleting (0 = delete as soon as closed).
TENDER_CLEANUP_GRACE_DAYS=0

# --- Authentication ---
SESSION_COOKIE_NAME=sid
# Hours a login session stays valid (720 = 30 days).
SESSION_TTL_HOURS=720
# Comma-separated emails auto-promoted to "admin" on signup. Leave unset and
# the very first account ever created becomes admin instead.
ADMIN_EMAILS=

# --- Email alerts ---
# Off by default -- turn on only once SMTP_USER/SMTP_APP_PASSWORD below are
# filled in with real values, otherwise every cycle just logs a skip.
ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# A Gmail App Password, NOT your normal account password:
# https://myaccount.google.com/apppasswords
# Never commit a real value here -- this file only ever holds placeholders.
SMTP_USER=
SMTP_APP_PASSWORD=
# Defaults to SMTP_USER if left blank.
ALERT_FROM_EMAIL=
# Required before SMTP credentials can be saved from the Admin Console.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_SETTINGS_KEY=

# --- Local backups ---
# Exports every table to backend/backups/<timestamp>/ on this schedule.
# Independent of Neon's own infra-level retention -- a supplementary,
# self-managed layer. Restoring from one is CLI-only (scripts/restore-backup.ts),
# never exposed over HTTP, given the overwrite risk.
BACKUP_ENABLED=true
BACKUP_CRON="0 4 * * *"
BACKUP_RETENTION_DAYS=14
