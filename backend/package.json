{
  "name": "rrp-groups-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Scraper + API backend for RRP Groups Tender Search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "scrape": "tsx src/scraper/runOnce.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "dotenv -e .env -o -- prisma generate",
    "prisma:migrate": "dotenv -e .env -o -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env -o -- prisma migrate deploy",
    "prisma:status": "dotenv -e .env -o -- prisma migrate status",
    "prisma:studio": "dotenv -e .env -o -- prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.4",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
